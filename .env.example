# Copy to .env (git-ignored) and fill in.

# Shared secret for OTA / reboot / revert / identify. Must equal
# CONFIG_FLEET_AGENT_TOKEN in every device's sdkconfig.defaults.local.
# Leave empty for monitor-only.
FLEET_DEVICE_TOKEN=

# Protects the web UI and API (the browser asks for it once).
# Leave empty only on a network you trust.
FLEET_ADMIN_TOKEN=

# Optional
#FLEET_LISTEN=0.0.0.0:8790
#FLEET_POLL_S=30
#FLEET_RETENTION_DAYS=14
#FLEET_OTA_TIMEOUT_S=600
#FLEET_MDNS=1
# Every event is POSTed here as JSON: {"event": {...}, "device_name": "..."}
#FLEET_WEBHOOK_URL=
#RUST_LOG=p4fleet=info,warn
